# Lab TLS certs ARE committed so the stack deploys with a single `docker compose up`
# (see README "Deploying on a PaaS"). They are throwaway self-signed certs for a
# training lab only. The CA private key is NOT needed at runtime, so keep it out:
config/wazuh_indexer_ssl_certs/root-ca.key
config/wazuh_indexer_ssl_certs/*.srl

# OS / editor noise
.DS_Store
*.swp
__pycache__/
*.pyc
